{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "PIC-140 Audit Event",
    "type": "object",
    "required": [
        "schema_version",
        "event_id",
        "timestamp",
        "topic",
        "payload",
        "chain_height",
        "previous_hash",
        "event_hash"
    ],
    "properties": {
        "schema_version": {
            "type": "string",
            "const": "1.0"
        },
        "event_id": {
            "type": "string",
            "pattern": "^AUD-EVT-[0-9A-Z]{26}$"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "correlation_id": {
            "type": "string",
            "pattern": "^COR-[0-9A-Z]{26}$"
        },
        "causation_id": {
            "type": ["string", "null"],
            "pattern": "^AUD-EVT-[0-9A-Z]{26}$"
        },
        "topic": {
            "type": "string"
        },
        "severity": {
            "type": "string",
            "enum": ["DEBUG", "TRACE", "INFO", "WARN", "SEC", "CRIT"]
        },
        "payload": {
            "type": "object"
        },
        "chain_height": {
            "type": "integer",
            "minimum": 0
        },
        "previous_hash": {
            "type": "string",
            "pattern": "^([a-fA-F0-9]{64}|GENESIS)$"
        },
        "event_hash": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
        },
        "signature": {
            "type": ["string", "null"]
        }
    }
}
